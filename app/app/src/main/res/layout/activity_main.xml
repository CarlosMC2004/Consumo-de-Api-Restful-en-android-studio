<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageViewLogoUteq"
        android:layout_width="332dp"
        android:layout_height="118dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo_uteq" />

    <TextView
        android:id="@+id/textViewListadoEstudiantes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Lista de Estudiantes"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/imageViewLogoUteq"
        app:layout_constraintStart_toStartOf="@+id/imageViewLogoUteq"
        app:layout_constraintTop_toBottomOf="@+id/imageViewLogoUteq" />

    <EditText
        android:id="@+id/editTextTextMultiLineListadoEstudiantes"
        android:layout_width="338dp"
        android:layout_height="483dp"
        android:layout_marginTop="24dp"
        android:ems="10"
        android:gravity="start|top"
        android:hint="Listado De Estudiantes"
        android:inputType="textMultiLine"
        app:layout_constraintEnd_toEndOf="@+id/textViewListadoEstudiantes"
        app:layout_constraintStart_toStartOf="@+id/textViewListadoEstudiantes"
        app:layout_constraintTop_toBottomOf="@+id/textViewListadoEstudiantes" />
</androidx.constraintlayout.widget.ConstraintLayout>